{
  "name": "dicewatcher",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r build",
    "dev:web": "pnpm --filter @dicewatcher/web dev",
    "dev:phone": "pnpm --filter @dicewatcher/web dev:phone",
    "build:web": "pnpm --filter @dicewatcher/web build",
    "build:foundry": "pnpm --filter @dicewatcher/foundry-module build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "vitest": "5.0.5"
  }
}
